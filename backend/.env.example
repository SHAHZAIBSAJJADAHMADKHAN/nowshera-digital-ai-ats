# Application
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth verification (placeholders only; keep real values in ignored .env)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=

# Server-to-server n8n authentication. Set a distinct real value only in ignored .env.
INTERNAL_AUTOMATION_KEY=

# Gemini is used only by the trusted server-side AI processor. Keep real values in ignored .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=120
